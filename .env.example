# Copy to .env and adjust. Used by docker-compose.yml.

# Port the front-end is published on → http://localhost:<FRONTEND_PORT>
FRONTEND_PORT=8080

# Django API origin as reachable from INSIDE the container:
#   http://host.docker.internal:8000  → Django running on your host machine
#   http://backend:8000               → a Django service on the same compose network
BACKEND_ORIGIN=http://host.docker.internal:8000
